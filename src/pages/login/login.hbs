<div class="login-page">
  <form class="login-form" action="#" novalidate>
    <h1 class="login-form__title">Вход</h1>

    <div class="login-form__fields">
      <label class="login-form__field">
        <span class="login-form__label">Логин</span>
        <input
          class="login-form__input"
          type="text"
          name="login"
          placeholder="Логин"
          autocomplete="username"
        />
      </label>

      <label class="login-form__field">
        <span class="login-form__label">Пароль</span>
        <input
          class="login-form__input"
          type="password"
          name="password"
          placeholder="Пароль"
          autocomplete="current-password"
        />
      </label>
    </div>

    <div class="login-form__actions">
      {{> button text="Войти" type="submit" view="primary" size="full" mix="login-form__submit"}}
      <a class="login-form__link" href="/sign-up">Ещё не зарегистрированы?</a>
    </div>
  </form>
</div>
