<form class="register-form" action="#" novalidate>
  <h1 class="register-form__title">Регистрация</h1>

  <div class="register-form__fields">
    <label class="register-form__field">
      <span class="register-form__label">Имя</span>
      <input
        class="register-form__input"
        type="text"
        name="first_name"
        placeholder="Имя"
        autocomplete="given-name"
      />
    </label>

    <label class="register-form__field">
      <span class="register-form__label">Фамилия</span>
      <input
        class="register-form__input"
        type="text"
        name="second_name"
        placeholder="Фамилия"
        autocomplete="family-name"
      />
    </label>

    <label class="register-form__field">
      <span class="register-form__label">Логин</span>
      <input
        class="register-form__input"
        type="text"
        name="login"
        placeholder="Логин"
        autocomplete="username"
      />
    </label>

    <label class="register-form__field">
      <span class="register-form__label">Почта</span>
      <input
        class="register-form__input"
        type="email"
        name="email"
        placeholder="email@example.com"
        autocomplete="email"
      />
    </label>

    <label class="register-form__field">
      <span class="register-form__label">Телефон</span>
      <input
        class="register-form__input"
        type="tel"
        name="phone"
        placeholder="+7 (999) 000-00-00"
        autocomplete="tel"
      />
    </label>

    <label class="register-form__field">
      <span class="register-form__label">Пароль</span>
      <input
        class="register-form__input"
        type="password"
        name="password"
        placeholder="Пароль"
        autocomplete="new-password"
      />
    </label>
  </div>

  <div class="register-form__actions">
    {{> button text="Зарегистрироваться" type="submit" view="primary" size="full" mix="register-form__submit"}}
    <a class="register-form__link" href="/login">Уже зарегистрированы? Войти</a>
  </div>
</form>
